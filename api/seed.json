    "subject":  "SCIENCE",
    "grade":  "11",
    "description":  "A 10.6 MB boombox for the waves unit. The speaker grilles, cassette deck and antenna make good landmarks for a lesson on amplitude, frequency and how sound travels through air.",
    "modelUrl":  "https://cdn.jsdelivr.net/gh/KhronosGroup/glTF-Sample-Assets@main/Models/BoomBox/glTF-Binary/BoomBox.glb",
    "markerId":  "ARU-AUDIO-601",
    "audioUrl":  null,
    "videoUrl":  null,
    "status":  "PUBLISHED",
    "version":  1,
    "createdBy":  "Dev Arjun Mehta",
    "trackingTestReport":  null,
    "averageRating":  0.0,
    "parts":  [
                  {
                      "id":  21,
                      "partName":  "speaker_grille",
                      "label":  "Speaker Grille",
                      "explanation":  "Behind the grille a cone pushes air back and forth. The frequency of that push is the pitch you hear; the size of it is the volume.",
                      "audioUrl":  null
                  },
                  {
                      "id":  22,
                      "partName":  "cassette_deck",
                      "label":  "Cassette Deck",
                      "explanation":  "A spinning magnet-reading head turns a magnetised tape back into an electric signal, which the speaker then converts to sound again - a full round trip of energy forms.",
                      "audioUrl":  null
                  },
                  {
                      "id":  23,
                      "partName":  "antenna",
                      "label":  "Antenna",
                      "explanation":  "A long conductor intercepts radio waves and turns them into a tiny current. Length matters: the best match comes at about a quarter of the wave\u0027s wavelength.",
                      "audioUrl":  null
                  }
              ],
    "questions":  [
                      {
                          "id":  18,
