                          "questionText":  "Why does cracked laminated visor glass often stay in one piece?",
                          "options":  [
                                          "a",
                                          "Because glass cannot crack",
                                          "b",
                                          "Because it is hollow",
                                          "c",
                                          "Because the pilot is strong",
                                          "d",
                                          "Because layers stop the crack from spreading"
                                      ],
                          "correctOption":  null,
                          "explanation":  null,
                          "topic":  "Materials"
                      },
                      {
                          "id":  3,
                          "questionText":  "Why does a pilot at altitude need the oxygen mask inside the helmet?",
                          "options":  [
                                          "a",
                                          "The air no longer has enough oxygen to breathe",
                                          "b",
                                          "The helmet makes oxygen",
                                          "c",
                                          "The wind is too cold",
                                          "d",
                                          "It blocks engine noise only"
                                      ],
                          "correctOption":  null,
                          "explanation":  null,
                          "topic":  "Physiology"
                      },
                      {
                          "id":  4,
                          "questionText":  "Why put speakers and microphones inside the ear cups?",
                          "options":  [
                                          "a",
                                          "To look symmetrical",
                                          "b",
                                          "To hold the strap in place",
                                          "c",
                                          "To isolate speech from the roar of the engine",
                                          "d",
                                          "To keep the ears warm"
                                      ],
                          "correctOption":  null,
                          "explanation":  null,
                          "topic":  "Comms"
                      },
                      {
                          "id":  5,
                          "questionText":  "What is the point of a quick-release chin strap?",
                          "options":  [
                                          "a",
                                          "It looks like a belt",
                                          "b",
                                          "It adjusts temperature",
                                          "c",
                                          "It frees the pilot fast in an emergency",
                                          "d",
                                          "It holds the oxygen tank"
                                      ],
                          "correctOption":  null,
